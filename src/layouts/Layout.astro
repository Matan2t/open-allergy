---
import '../styles/global.css';
import {
  GITHUB_URL,
  KOFI_IMAGE,
  KOFI_URL,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TAGLINE,
} from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_NAME} - ${SITE_TAGLINE}`,
  description = SITE_DESCRIPTION,
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Noto+Sans+Hebrew:wght@400;700;800&family=Noto+Sans+Arabic:wght@400;700;800&family=Noto+Sans+JP:wght@400;700;800&family=Noto+Sans+SC:wght@400;700;800&family=Noto+Sans+TC:wght@400;700;800&family=Noto+Sans+KR:wght@400;700;800&family=Noto+Sans+Thai:wght@400;700;800&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-logo">
          <span class="logo-mark" aria-hidden="true">OA</span>
          {SITE_NAME}
        </a>
        <nav class="site-nav">
          <a href="/cards/milk/english">Cards</a>
          <a href="/about">About</a>
          <a href="/faq">FAQ</a>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={KOFI_URL} target="_blank" rel="noopener noreferrer">Support</a>
          <a class="nav-cta" href="/order">Order plastic</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-glow" aria-hidden="true"></div>

      <div class="site-footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <span class="logo-mark" aria-hidden="true">OA</span>
              <span class="footer-logo-text">
                <strong>{SITE_NAME}</strong>
                <span>{SITE_TAGLINE}</span>
              </span>
            </a>
            <p class="footer-mission">
              Free food allergy travel cards for families who need to eat out and travel with more
              confidence. Open source. No account. No charge for downloads - ever.
            </p>
          </div>

          <div class="footer-support-card">
            <p class="footer-support-label">Support the project</p>
            <p class="footer-support-copy">
              If a card helped your family, a coffee keeps translations free for the next one.
            </p>
            <a class="kofi-button" href={KOFI_URL} target="_blank" rel="noopener noreferrer">
              <img src={KOFI_IMAGE} height="36" alt="Buy Me a Coffee at ko-fi.com" />
            </a>
          </div>
        </div>

        <nav class="footer-grid" aria-label="Footer">
          <div class="footer-col">
            <h3>Use the cards</h3>
            <ul>
              <li><a href="/cards/milk/english">Create a free card</a></li>
              <li><a href="/order">Order a plastic card</a></li>
              <li><a href="/#how-it-works">How it works</a></li>
              <li><a href="/faq">FAQ</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3>About</h3>
            <ul>
              <li><a href="/about">Why we built this</a></li>
              <li><a href="/contact">Contact</a></li>
              <li><a href="/contribute">Contribute</a></li>
              <li>
                <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
              </li>
              <li>
                <a href={KOFI_URL} target="_blank" rel="noopener noreferrer">Buy me a coffee</a>
              </li>
            </ul>
          </div>
          <div class="footer-col">
            <h3>Policies</h3>
            <ul>
              <li><a href="/shipping">Shipping</a></li>
              <li><a href="/returns">Returns</a></li>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/terms">Terms of service</a></li>
              <li>
                <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">
                  Code - MIT
                </a>
              </li>
            </ul>
          </div>
        </nav>

        <div class="footer-disclaimer">
          <strong>Medical disclaimer</strong>
          <p>
            These cards are a communication aid, not medical advice. Unverified translations may
            contain errors. Always carry prescribed emergency medication and confirm ingredients
            with staff when you can.
          </p>
        </div>

        <div class="footer-bottom">
          <p>© {year} {SITE_NAME}. Built for families who need clearer, safer meals abroad.</p>
          <p class="footer-bottom-meta">Free forever · Open source · Community verified</p>
        </div>
      </div>
    </footer>
  </body>
</html>
