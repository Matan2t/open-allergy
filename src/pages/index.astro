---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card';
import { allergens, languages, getAllergen, getLanguage } from '../lib/data';
import { GITHUB_URL } from '../lib/site';

const heroAllergen = getAllergen('milk') ?? allergens[0];
const heroLanguage = getLanguage('el') ?? languages[0];
const heroTranslation =
  heroAllergen.translations[heroLanguage.code] ?? heroAllergen.translations['en'];
---

<Layout>
  <section class="hero">
    <div class="hero-text">
      <h1>Allergy translation cards. <em>Free, forever.</em></h1>
      <p>
        Other sites charge up to $90 for a single allergy card. Here you pick your allergy, pick a
        language, and print a professional double-sided card at home — at no cost, with no account,
        and no catch. Open source, translated and verified by the community.
      </p>
      <p>
        <a class="btn btn-primary" href="/cards/milk/en">Make my free card</a>
        <a class="btn" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          Star on GitHub
        </a>
      </p>
    </div>
    <div class="hero-card screen-only">
      <Card language={heroLanguage} translation={heroTranslation} emoji={heroAllergen.emoji} />
    </div>
  </section>

  <section class="section">
    <h2>Pick your allergy</h2>
    <ul class="allergen-grid">
      {
        allergens.map((a) => (
          <li>
            <a href={`/cards/${a.id}/en`}>
              <span class="emoji">{a.emoji}</span>
              {a.translations['en'].allergen}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Available languages</h2>
    <ul class="language-chips">
      {
        languages.map((l) => (
          <li>
            <a href={`/cards/milk/${l.code}`}>{l.nativeName}</a>
          </li>
        ))
      }
    </ul>
    <p>
      Missing your language? <a href="/contribute">Add it with a pull request</a> — no coding
      required.
    </p>
  </section>

  <section class="section">
    <h2>How it works</h2>
    <ol class="steps">
      <li>
        <h3>Choose allergy and language</h3>
        <p>14 allergens, 12 languages, every combination previewed live in your browser.</p>
      </li>
      <li>
        <h3>Print or download — free</h3>
        <p>
          Print at true credit-card size, save as PDF, download a high-resolution PNG, or print an
          A4 sheet with cut lines.
        </p>
      </li>
      <li>
        <h3>Optional: order a plastic card</h3>
        <p>
          Want a durable plastic card mailed to you? Order one for a small fee that keeps this
          project running. The free downloads are identical.
        </p>
      </li>
    </ol>
  </section>

  <section class="section">
    <h2>Why open source?</h2>
    <p style="max-width: 46rem; color: var(--ink-soft);">
      Translation accuracy is a safety issue. Every card's text lives in a public GitHub
      repository where native speakers review and verify each translation. If something is wrong,
      anyone can fix it for everyone — instead of paying a company to maybe fix it someday.
      Unverified translations are clearly marked until a native speaker signs off.
    </p>
  </section>
</Layout>
