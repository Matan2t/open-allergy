---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card';
import { allergens, languages, getAllergen, getLanguage } from '../lib/data';
import { GITHUB_URL, SITE_NAME } from '../lib/site';

const heroAllergen = getAllergen('milk') ?? allergens[0];
const heroLanguage = getLanguage('greek') ?? languages[0];
const heroTranslation =
  heroAllergen.translations[heroLanguage.code] ?? heroAllergen.translations['english'];
const enLanguage = getLanguage('english') ?? languages[0];
const enTranslation = heroAllergen.translations['english'];
const langCount = languages.length;
---

<Layout>
  <section class="hero">
    <div class="hero-text">
      <span class="hero-brand">{SITE_NAME}</span>
      <h1>Be clear. <em>Eat safe.</em></h1>
      <p class="hero-lead">
        Free double-sided allergy cards in {langCount} languages - your language on the front,
        English on the back. Print at home. No account. No charge. Open source forever.
      </p>
      <p class="hero-actions">
        <a class="btn btn-primary" href="/cards/milk/greek">Make my free card</a>
        <a class="btn" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          Star on GitHub
        </a>
      </p>
    </div>
    <div class="hero-visual screen-only">
      <div class="hero-card-stack">
        <div class="hero-back" aria-hidden="true">
          <Card language={enLanguage} translation={enTranslation} emoji={heroAllergen.emoji} />
        </div>
        <div class="hero-front">
          <Card language={heroLanguage} translation={heroTranslation} emoji={heroAllergen.emoji} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Pick your allergy</h2>
    <ul class="allergen-grid">
      {
        allergens.map((a) => (
          <li>
            <a href={`/cards/${a.id}/english`}>
              <span class="emoji">{a.emoji}</span>
              {a.translations['english'].allergen}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2>Available languages</h2>
    <ul class="language-chips">
      {
        languages.map((l) => (
          <li>
            <a href={`/cards/milk/${l.code}`}>{l.nativeName}</a>
          </li>
        ))
      }
    </ul>
    <p class="section-lead" style="margin-top: 1rem;">
      Missing your language? <a href="/contribute">Add it with a pull request</a> - no coding
      required.
    </p>
  </section>

  <section class="section">
    <h2>How it works</h2>
    <ol class="steps">
      <li>
        <h3>Choose allergy and language</h3>
        <p>
          14 allergens, {langCount} languages. Live preview of both card sides in your browser.
        </p>
      </li>
      <li>
        <h3>Show, print, or download - free</h3>
        <p>
          Open the card fullscreen on your phone for staff, print at true credit-card size, save as
          PDF, download a high-resolution PNG, or print an A4 sheet with cut lines.
        </p>
      </li>
      <li>
        <h3>Optional: order a plastic card</h3>
        <p>
          Want a durable plastic card mailed to you? Order one for a small fee that keeps this
          project running. Free downloads are identical in content.
        </p>
      </li>
    </ol>
  </section>

  <section class="section">
    <h2>Why open source?</h2>
    <p class="section-lead">
      Translation accuracy is a safety issue. Every card's text lives in a public GitHub repository
      where native speakers review and verify each translation. If something is wrong, anyone can
      fix it for everyone - instead of paying a company to maybe fix it someday. Unverified
      translations are clearly marked until a native speaker signs off.
    </p>
  </section>
</Layout>
