---
import Layout from '../../../layouts/Layout.astro';
import CardBuilder from '../../../components/CardBuilder';
import { allergens, languages } from '../../../lib/data';

export function getStaticPaths() {
  return allergens.flatMap((allergen) =>
    languages
      .filter((language) => allergen.translations[language.code])
      .map((language) => ({
        params: { allergen: allergen.id, lang: language.code },
      }))
  );
}

const { allergen, lang } = Astro.params;
const allergenData = allergens.find((a) => a.id === allergen)!;
const languageData = languages.find((l) => l.code === lang)!;
const enName = allergenData.translations['english'].allergen;

const title = `${enName} allergy card in ${languageData.name} - free printable`;
const description = `Free printable ${enName.toLowerCase()} allergy translation card in ${languageData.name}. Credit-card size, double-sided with English. Open source and verified by the community.`;
---

<Layout title={title} description={description}>
  <section class="section">
    <h2 class="no-print">
      {allergenData.emoji}
      {enName} allergy card - {languageData.name}
    </h2>
    <CardBuilder
      client:load
      initialAllergen={allergenData.id}
      initialLang={languageData.code}
    />
  </section>
</Layout>
