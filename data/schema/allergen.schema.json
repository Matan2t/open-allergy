{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openallergycards.pages.dev/schema/allergen.schema.json",
  "title": "Allergen card data",
  "description": "One allergen with its card text translated into multiple languages.",
  "type": "object",
  "required": ["id", "emoji", "translations"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Kebab-case identifier; must match the file name."
    },
    "emoji": {
      "type": "string",
      "minLength": 1,
      "description": "Emoji used as the card icon."
    },
    "translations": {
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "description": "Card text keyed by ISO 639-1 language code.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Za-z]{2,4})?$": {
          "type": "object",
          "required": [
            "verified",
            "allergen",
            "statement",
            "description",
            "foundInLabel",
            "foundIn",
            "question"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "boolean",
              "description": "True once a native speaker has reviewed this translation."
            },
            "allergen": {
              "type": "string",
              "minLength": 1,
              "description": "Allergen name in this language."
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "description": "Bold first-person statement, e.g. 'I have a severe milk allergy.'"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Explanation of severity and consequences."
            },
            "foundInLabel": {
              "type": "string",
              "minLength": 1,
              "description": "Heading for the ingredient list, e.g. 'Milk can be found in:'"
            },
            "foundIn": {
              "type": "array",
              "minItems": 3,
              "maxItems": 12,
              "items": { "type": "string", "minLength": 1 },
              "description": "Common ingredients/dishes that contain the allergen."
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "description": "Direct closing question, e.g. 'Does this food contain milk?'"
            }
          }
        }
      }
    }
  }
}
