// Cloudflare Workers configuration.
// The static Astro build in ./dist is served as assets; the Worker itself
// only handles /api/* (Stripe checkout).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-allergy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
